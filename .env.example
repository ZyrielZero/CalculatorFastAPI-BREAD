# Copy to .env and fill in real values. .env is gitignored — the example
# file documents the shape without ever committing a live secret.

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-chars

# Only needed when running the app outside Docker Compose; inside
# Compose the web service overrides this with the in-network db host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_db